{
  "name": "anything-llm-frontend",
  "private": false,
  "engines": {
    "node": ">=24 <25"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "dev": "cross-env NODE_ENV=development vite --debug --host=0.0.0.0",
    "build": "pnpm typecheck && vite build && node scripts/postbuild.js",
    "preview:local-tools": "node scripts/preview-local-tools.mjs",
    "test:proposal-fill": "node --test scripts/tests/proposalFill.test.mjs",
    "test:api-workflow": "node --test scripts/tests/apiWorkflow.test.mjs",
    "test:network-auth": "vitest run src/utils/networkAuth.test.mjs",
    "lint:check": "eslint src",
    "lint": "eslint --fix src",
    "preview": "vite preview",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:tools": "pnpm typecheck",
    "test:agent-admin": "node --test scripts/tests/agentAdmin.test.mjs",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@coregenie/contracts": "workspace:*",
    "@headlessui/react": "^1.7.19",
    "@lobehub/icons": "^4.0.3",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@phosphor-icons/react": "^2.1.7",
    "@tanstack/react-query": "^5.108.4",
    "@tremor/react": "^3.15.1",
    "cronstrue": "^2.50.0",
    "dompurify": "^3.0.8",
    "fflate": "0.8.3",
    "file-saver": "^2.0.5",
    "he": "^1.2.0",
    "highlight.js": "^11.9.0",
    "i18next": "^23.11.3",
    "js-levenshtein": "^1.1.6",
    "katex": "0.16.11",
    "lodash.debounce": "^4.0.8",
    "markdown-it": "^13.0.1",
    "moment": "^2.30.1",
    "pluralize": "^8.0.0",
    "react": "^18.2.0",
    "react-beautiful-dnd": "13.1.1",
    "react-confetti-explosion": "^2.1.2",
    "react-device-detect": "^2.2.2",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-error-boundary": "^6.0.0",
    "react-highlight-words": "^0.21.0",
    "react-i18next": "^14.1.1",
    "react-loading-skeleton": "^3.1.0",
    "react-router-dom": "^6.3.0",
    "react-tag-input-component": "^2.0.2",
    "react-toastify": "^9.1.3",
    "react-tooltip": "^5.25.2",
    "recharts": "^2.12.5",
    "recharts-to-png": "^2.3.1",
    "text-case": "^1.0.9",
    "truncate": "^3.0.0",
    "uuid": "^9.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/react": "^18.2.23",
    "@types/react-dom": "^18.2.8",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/parser": "8.46.4",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "^10.4.14",
    "buffer": "^6.0.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.3",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "playwright": "1.65.0",
    "postcss": "^8.4.23",
    "prettier": "^3.0.3",
    "rollup-plugin-visualizer": "^5.9.0",
