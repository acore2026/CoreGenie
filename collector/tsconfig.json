{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "allowJs": true,
    "noEmit": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "**/*.js",
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "hotdir",
    "outputs"
  ]
}
